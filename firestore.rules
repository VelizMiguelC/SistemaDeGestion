rules_version = '2';

// Esta app es de un solo dueño (Miguel) sin distintos roles ni datos de
// terceros: cualquier usuario autenticado con Firebase Auth ES el dueño,
// así que "autenticado" es exactamente el control de acceso que hace
// falta -no hay nada más fino que validar-.
//
// La app (inventario_app) siempre pide login antes de leer o escribir
// nada (ver AuthGate en lib/main.dart), así que esta regla no le cambia
// el comportamiento en nada. El script de importación
// (scripts/import_deudas_firestore.py) usa el SDK de administrador con
// serviceAccountKey.json, que se salta estas reglas por diseño -tampoco
// se ve afectado-.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
